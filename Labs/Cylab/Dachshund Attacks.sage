




cf = (e/n).continued_fraction()


for conv in cf.convergents():
    k = conv.numerator()
    d=conv.denominator()
    if k==0:
        continue
    if (e*d-1) % k == 0:
      phi = (e*d-1)//k
      s= n-phi+1
      D = s*s-4*n
      if (D > 0 and D.is_square()) :
        p = ( s + sqrt(D) ) // 2
        q = ( s - sqrt(D) ) // 2
        if n == p*q:
          m = power_mod(int(c), int(d), int(n))
          bytes_size = (m.bit_length() + 7) // 8
          print(m.to_bytes(bytes_size, 'big').decode('utf-8'))
